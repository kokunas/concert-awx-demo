{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConcertDiskArchiveObjectRW",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE-WITH-YOUR-BUCKET/*"
    },
    {
      "Sid": "ConcertDiskArchiveList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::REPLACE-WITH-YOUR-BUCKET"
    }
  ]
}
