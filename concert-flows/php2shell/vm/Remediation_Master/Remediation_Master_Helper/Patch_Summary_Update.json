{
 "name": "Patch_Summary_Update",
 "platform": "node",
 "hash": "LufVVusI28ayZOhc2zRIdpS8VRgwrOl32JTpRsYMY6A=",
 "blocks": [
  {
   "action": "comment",
   "value": "function to get patch status from patch summary report"
  },
  {
   "name": "Function_1",
   "function": "var result = []\n\nObject.entries($patch_summary_report).forEach(([ip, details]) => {\n    if (details[\"status\"] == \"success\" || details[\"status\"] == \"failed\" || details[\"status\"] == \"scheduled\"){\n        result.push({\n        ip: ip,\n        status: details[\"status\"]});\n    }\n});\n\n$func_result = $func_result.concat(result)"
  },
  {
   "action": "if",
   "name": "CheckFuncResult",
   "condition": "$func_result.length > 0",
   "then": [
    {
     "action": "foreach",
     "name": "ForEachIp",
     "list": "$func_result",
     "blocks": [
      {
       "action": "comment",
       "value": "assign action status for each action per IP"
      },
      {
       "action": "assign",
       "name": "ActionID",
       "value": "$IPActionIdMap[$ForEachIp.item[\"ip\"]]",
       "variable": "$action_id"
      },
      {
       "action": "system/IBM/Concert v2/Action Insights/Search in Actions",
       "name": "getScheduledActionList",
       "inputs": [
        {
         "name": "authKey",
         "value": "$concert_auth"
        },
        {
         "name": "Body",
         "value": "{\n    \"filters\": {\n        \"logic\": \"and\",\n\n        \"conditions\": [{\n            \"field\": \"actions_identifier\",\n            \"value\": $action_id,\n            \"operator\": \"IN\"\n        }, {\n            \"field\": \"risk_type\",\n            \"value\": \"VULNERABILITY\",\n            \"operator\": \"=\"\n        }]\n    },\n    \"sort\": {\n        \"field\": \"last_update_date\",\n        \"order\": \"asc\"\n    }\n}"
        }
       ]
      },
      {
       "action": "system/Common/JSON/JSON Parse",
       "name": "actionDetails",
       "inputs": [
        {
         "name": "jsonString",
         "value": "$getScheduledActionList?.result?.actions?.[0]?.action_details"
        }
       ]
      },
      {
       "action": "assign",
       "name": "CR",
       "variable": "$change_request",
       "value": "$actionDetails?.result?.change_request"
      },
      {
       "action": "comment",
       "value": "function to append new  changes to history object"
      },
      {
       "name": "Function_2",
       "function": "function createUpdateBody(record, status, username) {\n    let historyObject = [];\n    let updatedActions = [];\n    let status_val = status\n\n    try {\n        if (typeof record.history === \"string\") {\n            historyObject = JSON.parse(record.history);\n        } else if (Array.isArray(record.history)) {\n            historyObject = record.history;\n        }\n    } catch (e) {\n        historyObject = [];\n    }\n\n    let newEvent = {\n        \"event\": \"Action status update: \" + status_val,\n        \"comments\": \"Action status has been updated to:\" + status_val,\n        \"timestamp\": Math.floor(Date.now() / 1000),\n        \"user\": username\n    };\n\n    historyObject.push(newEvent);\n\n    const action = {\n        action_id: record.actions_identifier,\n        status: status_val,\n        history: JSON.stringify(historyObject)\n    };\n\n    updatedActions.push(action);\n    return updatedActions;\n}\n\n// New function to handle multiple actions\nfunction createUpdateBodyForAll(actions, status, username) {\n    let allUpdatedActions = [];\n\n    actions.forEach(action => {\n        // Assuming status here is a string like \"success\" or \"failed\"\n        // If status is per action, you will need to adjust accordingly\n        const updated = createUpdateBody(action, status, username);\n        allUpdatedActions = allUpdatedActions.concat(updated);\n    });\n\n    return allUpdatedActions;\n}\n\n$patch_status = $func_result.find(item => item.ip === $ForEachIp.item[\"ip\"])?.status || \"failed\";\n$result_body = createUpdateBodyForAll($getScheduledActionList.result.actions, $patch_status, $username);\n\n"
      },
      {
       "action": "comment",
       "value": "Update action status in DB"
      },
      {
       "action": "system/IBM/Concert v2/Action Insights/Update Existing Action",
       "name": "updateStatus",
       "inputs": [
        {
         "name": "authKey",
         "value": "$concert_auth"
        },
        {
         "name": "Body",
         "value": "{\n    \"actions\": $result_body\n}"
        }
       ]
      },
      {
       "action": "if",
       "name": "If_1",
       "condition": "$updateStatus && Array.isArray($updateStatus.result?.actions) && $updateStatus.result.actions.length > 0",
       "then": [
        {
         "action": "system/Common/Array/Array Push",
         "name": "responseArray",
         "inputs": [
          {
           "name": "array",
           "value": "$result"
          },
          {
           "name": "item",
           "value": "\"Status Updated for the action_ids \" + $IPActionIdMap[$ForEachIp.item[\"ip\"]] + \" as \" + $patch_status"
          }
         ]
        }
       ],
       "else": [
        {
         "action": "system/Common/Array/Array Push",
         "name": "responseArray_1",
         "inputs": [
          {
           "name": "array",
           "value": "$result"
          },
          {
           "name": "item",
           "value": "\"Status Updated for the actions \" + $IPActionIdMap[$ForEachIp.item[\"ip\"]] + \" got failed !\""
          }
         ]
        }
       ]
      },
      {
       "action": "comment",
       "value": "Update Change Request"
      },
      {
       "action": "if",
       "name": "IfServiceNowChangeRequest",
       "condition": "$change_request && $change_request.source !== 'Concert' && $change_request.identifier && $sm_auth && $sm_auth !== ''",
       "then": [
        {
         "action": "if",
         "name": "patchStatus",
         "condition": "$patch_status == \"success\"",
         "then": [
          {
           "action": "system/ServiceNow/updateTable",
           "name": "UpdateCR",
           "inputs": [
            {
             "name": "authKey",
             "value": "$sm_auth"
            },
            {
             "name": "tableName",
             "value": "'incident'"
            },
            {
             "name": "sys_id",
             "value": "$change_request.identifier"
            },
            {
             "name": "fields",
             "value": "{}"
            },
            {
             "name": "Table",
             "value": "{\n    \"state\": 6,\n    \"close_code\": \"Resolved by caller\",\n    \"close_notes\": \"Patch applied successfully. Vulnerabilities mitigated\"\n}"
            }
           ]
          }
         ],
         "else": [
          {
           "action": "system/ServiceNow/updateTable",
           "name": "UpdateCR_1",
           "inputs": [
            {
             "name": "authKey",
             "value": "$sm_auth"
            },
            {
             "name": "tableName",
             "value": "'incident'"
            },
            {
             "name": "sys_id",
             "value": "$change_request.identifier"
            },
            {
             "name": "fields",
             "value": "{}"
            },
            {
             "name": "Table",
             "value": "{\n    \"comments\": \"Patching has been failed\"\n}"
            }
           ]
          }
         ]
        }
       ],
       "else": []
      }
     ]
    }
   ],
   "else": [
    {
     "action": "system/Common/Array/Array Push",
     "name": "EmptyFuncResult",
     "inputs": [
      {
       "name": "array",
       "value": "$result"
      },
      {
       "name": "item",
       "value": "\"patch_summary_report is empty\""
      }
     ]
    }
   ]
  }
 ],
